# Optional development proxy target. Default: http://localhost:2567
# CHAOS_SERVER=http://localhost:2567

# Optional public production WebSocket address (requires a reachable backend).
# VITE_CHAOS_SERVER=wss://your-game-server.example

# Optional TURN settings for voice across restrictive networks.
# VITE_* values are included in browser builds; use an appropriate short-lived
# TURN credential strategy for production rather than a private long-lived key.
# VITE_TURN_URL=
# VITE_TURN_USER=
# VITE_TURN_PASS=
