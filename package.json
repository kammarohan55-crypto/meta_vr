    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p cloud/tsconfig.json",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/main.ts",
    "test": "node scripts/run-tests.mjs",
    "test:interaction": "node scripts/verify-hand-mechanics.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "start": "node scripts/start-production.mjs",
    "check": "npm run doctor && npm run typecheck && npm test && npm run test:interaction && npm run build",
    "cloud:types": "wrangler types cloud/worker-configuration.d.ts",
    "cloud:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0-rc.2",
