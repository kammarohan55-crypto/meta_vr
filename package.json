    "@types/three": "^0.185.0",
    "esbuild": "0.28.2",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "three": "npm:super-three@0.185.0"
  },
